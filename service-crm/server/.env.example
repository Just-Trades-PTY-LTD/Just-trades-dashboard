# --- Server ---
PORT=4100
CLIENT_ORIGIN=http://localhost:5273

# SQLite file location (relative to service-crm/server, or an absolute path).
# In production this MUST point at storage that survives a restart/redeploy
# (e.g. a Railway volume's mount path) — see ALLOW_FRESH_DB_INIT below.
DB_PATH=./data/crm.sqlite

# Safety switch: in production (NODE_ENV=production), the server refuses to
# create a brand-new database if none exists at DB_PATH — it shows a clear
# warning page instead of silently starting empty, since that's how a storage
# problem previously turned into total data loss. Set this to true ONLY for a
# genuine first-ever setup, redeploy once, confirm it started normally, then
# remove this variable (or set it to false) again. Not needed in local dev —
# NODE_ENV isn't "production" there, so a fresh DB is always created.
ALLOW_FRESH_DB_INIT=false

# Cookie signing / session secret. Change this in production.
SESSION_SECRET=change-me-in-production

# How long a login session lasts, in days.
SESSION_DAYS=30

# The first time the server starts with an empty users table, it creates one
# admin account from these values so you can log in and add real staff.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@justtrades.au
SEED_ADMIN_PASSWORD=change-me-on-first-login
