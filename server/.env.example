# Set to "live" once your AroFlo API credentials below are confirmed working,
# or "mock" to run the dashboard against realistic sample data with no AroFlo
# account needed. See README.md for how to obtain each AroFlo credential.
AROFLO_MODE=mock

# --- Live AroFlo API credentials (only needed when AROFLO_MODE=live) ---
# Issued by AroFlo support when API access is enabled on your account.
AROFLO_SDK_KEY=
# Generated under AroFlo > Setup > API Access on your account.
AROFLO_ACCESS_KEY=
AROFLO_SECRET_KEY=
# Confirm this against the Postman collection linked from your account's
# API docs portal (https://apidocs.aroflo.com) — it may differ per region/plan.
AROFLO_BASE_URL=https://api.aroflo.com

# --- Server ---
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# How often (ms) the backend re-pulls data from AroFlo and refreshes the
# in-memory dashboard cache.
REFRESH_INTERVAL_MS=60000
